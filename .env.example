# Scraping local
IMPORT_CARS_CONCURRENCY=8
IMPORT_CARS_REQUEST_TIMEOUT=15
IMPORT_CARS_MAX_RETRIES=4
IMPORT_CARS_MAX_PAGES=5
IMPORT_CARS_PAGE_PAUSE_MIN=0.5
IMPORT_CARS_PAGE_PAUSE_MAX=1.5
IMPORT_CARS_HEADLESS=true
IMPORT_CARS_PLAYWRIGHT_CHANNEL=chrome

# Lista JSON opcional, por ejemplo: ["http://usuario:clave@proxy:puerto"]
IMPORT_CARS_PROXY_POOL=[]

# Obligatorio antes de exponer el dashboard interno fuera de localhost
IMPORT_CARS_INTERNAL_USERNAME=
IMPORT_CARS_INTERNAL_PASSWORD=

# Persistencia desacoplada: fiscal, actividad de clientes y seguimiento de mercado
IMPORT_CARS_FISCAL_DATABASE_PATH=data/import_cars.sqlite3
IMPORT_CARS_CUSTOMER_DATABASE_PATH=data/customer_activity.sqlite3
IMPORT_CARS_MARKET_DATABASE_PATH=data/market_tracking.sqlite3
IMPORT_CARS_MARKET_CACHE_TTL=900
IMPORT_CARS_MANAGEMENT_FEE=900
IMPORT_CARS_MAX_RELIABLE_SAVINGS_PCT=35
# Solo dígitos con prefijo de país, por ejemplo 34600000000
IMPORT_CARS_WHATSAPP_NUMBER=
